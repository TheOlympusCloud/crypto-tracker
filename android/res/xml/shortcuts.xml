<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: the way back to the server settings from a full-screen page. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/icon"
        android:shortcutShortLabel="@string/settings">
        <intent
            android:action="cloud.theolympus.cryptotracker.SETTINGS"
            android:targetClass="cloud.theolympus.cryptotracker.MainActivity"
            android:targetPackage="cloud.theolympus.cryptotracker" />
    </shortcut>
</shortcuts>
